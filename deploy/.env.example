# Copy to deploy/.env (ignored by git) and fill in. Every value here is a frozen
# element or depends on one: record the final values in the freeze.

# Bench image tag = the bench version written into every record. Use the git tag.
BENCH_VERSION=

# vLLM image, exact tag (not "latest").
VLLM_IMAGE=vllm/vllm-openai:
HF_CACHE=/srv/hf-cache

# 8B generator. GEN_VERSION_ID is what the plan declares as version_id and what vLLM
# returns as "model": the bench flags any mismatch as model-substitution.
GEN_MODEL=
GEN_REVISION=
GEN_VERSION_ID=
GEN_EXTRA_ARGS=

# Embedder. The flag that enables embedding mode changed across vLLM versions: check the
# documentation of the tag in VLLM_IMAGE.
EMBED_MODEL=
EMBED_REVISION=
EMBED_VERSION_ID=
EMBED_SERVE_ARGS=

# API generators (only with compose.api.yaml).
WEBRAG_KEY_G1=
WEBRAG_KEY_G2=
WEBRAG_KEY_G3=
